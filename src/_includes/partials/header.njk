<!-- BEGIN: MainHeader -->
<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-brand-border" data-purpose="sticky-navbar"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between"><a class="flex items-center space-x-2.5 group" data-purpose="navbar-brand" href="#hero"><img alt="{{ site.brandName }} avatar" class="w-10 h-10 rounded-full object-cover ring-2 ring-brand-navy/10 group-hover:scale-105 transition-transform duration-200" src="{{ site.avatarImage | url }}"><div><h1 class="font-bold text-brand-navy text-sm sm:text-base leading-tight group-hover:text-brand-blue transition-colors">{{ site.brandName }}</h1><p class="text-[11px] sm:text-xs text-brand-slate font-medium">{{ site.brandTagline }}</p></div></a><nav aria-label="Primary" class="hidden lg:flex items-center space-x-7 text-sm font-semibold text-brand-navy/80" data-purpose="desktop-nav">{% for link in site.navLinks %}<a class="hover:text-brand-blue transition-colors py-1" href="{{ link.href }}">{{ link.label }}</a>{% endfor %}</nav><div class="flex items-center space-x-2"><a class="inline-flex items-center justify-center px-4 py-2 rounded-full bg-brand-blue text-white text-xs sm:text-sm font-bold hover:bg-brand-cobalt transition-all shadow-sm active:scale-95" data-purpose="nav-cta" href="{{ site.navCta.href }}">{{ site.navCta.label }}</a></div></div></header>
<!-- END: MainHeader -->
