{% import "partials/icons.njk" as icons %}
<!-- Experience Role Entry -->
<div class="relative flex items-start gap-6 group">
<div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white border-2 border-brand-navy flex items-center justify-center text-brand-blue flex-shrink-0 z-10 shadow-comic group-hover:scale-105 transition-transform">
{{ icons.icon(role.icon) }}
</div>
<div class="bg-white border border-brand-border p-6 sm:p-7 rounded-2xl flex-1 hover:border-brand-navy transition-all duration-200 hover:shadow-sm">
<div class="flex flex-col sm:flex-row sm:items-center justify-between mb-3">
<h3 class="text-xl font-bold text-brand-navy">
                  {{ role.title }} <span class="text-brand-blue font-normal">— {{ role.company }}</span>
</h3>
<span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full {% if role.dateRangeStyle == 'current' %}bg-brand-ice text-brand-blue border border-blue-200{% else %}bg-slate-100 text-slate-600 border border-slate-200{% endif %} mt-1 sm:mt-0 w-fit">
                  {{ role.dateRange }}
                </span>
</div>
{% if role.progression %}<p class="text-xs font-semibold text-brand-slate uppercase mb-3">{{ role.progression }}</p>{% endif %}
<ul class="space-y-2 {% if role.progression %}text-sm sm:text-base{% else %}mt-4 text-sm sm:text-base{% endif %} text-brand-slate list-disc list-inside">
{% for bullet in role.bullets %}<li>{{ bullet | mdInline | safe }}</li>
{% endfor %}
</ul>
</div>
</div>
