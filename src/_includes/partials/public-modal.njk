<!-- BEGIN: Public Case Study Modal (Iqro Land) -->
<!-- Deliberately a SEPARATE dialog from #confidentialModal rather than the same one with
     conditionals. The two say opposite things: one explains why the detail is withheld,
     this one exists because there is nothing to withhold. Folding them together would
     have meant a badge, an intro, a body and a CTA that all swap , at which point they
     are two dialogs sharing a wrapper anyway. The a11y structure is kept identical
     (role, aria-modal, inert, backdrop, Escape) so both behave the same to a screen
     reader and to the existing modal tests. -->
<div aria-labelledby="publicModalTitle" aria-modal="true" class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-300 ease-out" id="publicModal" inert role="dialog">
<div class="fixed inset-0 bg-slate-900/60 backdrop-blur-md transition-opacity" id="publicModalBackdrop"></div>
<div class="relative bg-white rounded-3xl border-2 border-brand-navy max-w-3xl w-full p-6 sm:p-8 shadow-2xl z-10 transform scale-95 transition-all max-h-[90vh] overflow-y-auto">
<!-- Close Button -->
<button aria-label="Close case study" class="public-modal-close absolute top-4 right-4 w-11 h-11 rounded-full bg-slate-100 hover:bg-slate-200 text-brand-navy flex items-center justify-center transition-colors" type="button">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
<!-- Header -->
<div class="flex items-center gap-3 mb-4 pr-10">
<div class="w-12 h-12 rounded-2xl bg-emerald-50 border-2 border-emerald-600 flex items-center justify-center text-emerald-700 shadow-comic flex-shrink-0">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
<path d="M7 11V7a5 5 0 0 1 9.9-1" stroke-linecap="round"></path>
</svg>
</div>
<div class="min-w-0">
<div class="flex items-center gap-1.5 flex-wrap">
{% for badge in iqroLand.badges %}<span class="px-2.5 py-0.5 rounded-full {% if loop.first %}bg-emerald-100 text-emerald-800{% else %}bg-amber-100 text-amber-800{% endif %} text-[11px] font-bold whitespace-nowrap">{{ badge }}</span>{% endfor %}
</div>
<h3 class="text-xl font-extrabold text-brand-navy mt-1" id="publicModalTitle">{{ iqroLand.defaultTitle }}</h3>
</div>
</div>
<!-- Narrative -->
<div class="space-y-3.5 text-sm text-brand-slate leading-relaxed border-t border-slate-100 pt-4 mt-4">
<p class="text-brand-navy font-semibold">{{ iqroLand.intro }}</p>
{% for paragraph in iqroLand.paragraphs %}<p>{{ paragraph }}</p>
{% endfor %}
</div>
<!-- Breakdown cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
{% for card in iqroLand.cards %}
<div class="bg-brand-light p-4 rounded-2xl border border-brand-border">
<span class="inline-block px-3 py-1 bg-brand-ice text-brand-blue font-extrabold text-[11px] rounded-md mb-2 uppercase tracking-wide">{{ card.label }}</span>
<p class="text-brand-slate text-sm leading-relaxed">{{ card.body }}</p>
</div>
{% endfor %}
</div>
<!-- Visual. Labelled as a concept visualization in BOTH the eyebrow and the caption,
     because the image is a mockup of the intended screen, not a capture of the running
     pre-alpha , and a portfolio that blurs that line is the kind of thing a reader only
     has to catch once. -->
<div class="mt-8" data-purpose="concept-visual">
<p class="text-xs font-bold text-brand-slate uppercase tracking-wider mb-3">{{ iqroLand.visual.label }}</p>
<figure class="m-0">
<img alt="{{ iqroLand.visual.alt }}" class="w-full h-auto rounded-2xl border-2 border-brand-border" height="{{ iqroLand.visual.height }}" loading="lazy" src="{{ iqroLand.visual.src | url }}" width="{{ iqroLand.visual.width }}">
<figcaption class="text-xs text-brand-slate mt-2">{{ iqroLand.visual.caption }}</figcaption>
</figure>
</div>
<!-- App screenshots. Real captures of the running pre-alpha, deliberately kept in its own
     labelled block rather than merged with the concept mockup above , the whole point of
     this section is that it is NOT a mockup. A horizontal snap-scroll carousel rather than
     a grid because twelve full screens at once would dwarf the rest of the dialog; arrow
     buttons are progressive enhancement over the native swipe/scroll that already works
     with JS off. -->
<div class="mt-8" data-purpose="app-screens">
<div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
<p class="text-xs font-bold text-brand-slate uppercase tracking-wider">{{ iqroLand.screens.label }}</p>
<p class="text-xs text-brand-slate">{{ iqroLand.screens.note }}</p>
</div>
<div class="relative">
<div aria-label="Iqro Land app screenshots, scroll or use the arrow buttons to see more" class="app-screens-track flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 -mx-1 px-1" data-purpose="app-screenshot-track" role="group" tabindex="0">
{% for item in iqroLand.screens.items %}
<figure class="m-0 flex-shrink-0 w-[78%] sm:w-[55%] snap-center" data-purpose="app-screenshot">
<!-- Not loading="lazy": these sit in a horizontally-scrolling track, so most of the
     twelve are laid out far outside the viewport's rootMargin and would never cross the
     threshold that triggers a native lazy load , they would simply never fetch. Total
     payload for all twelve WebP captures is well under 600KB. -->
<img alt="{{ item.alt }}" class="w-full h-auto rounded-2xl border-2 border-brand-border" height="800" src="{{ item.src | url }}" width="1280">
<figcaption class="text-xs text-brand-slate mt-2">{{ item.caption }}</figcaption>
</figure>
{% endfor %}
</div>
<button aria-label="Previous screen" class="app-screens-prev hidden sm:flex absolute left-0 top-[38%] -translate-y-1/2 -translate-x-1/2 w-9 h-9 rounded-full bg-white border-2 border-brand-navy text-brand-navy items-center justify-center shadow-comic hover:bg-brand-light" type="button">
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</button>
<button aria-label="Next screen" class="app-screens-next hidden sm:flex absolute right-0 top-[38%] -translate-y-1/2 translate-x-1/2 w-9 h-9 rounded-full bg-white border-2 border-brand-navy text-brand-navy items-center justify-center shadow-comic hover:bg-brand-light" type="button">
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</button>
</div>
</div>
<!-- CTA -->
{% if iqroLand.cta.enabled %}
<div class="flex flex-col sm:flex-row gap-3 pt-6">
<a class="public-modal-cta flex-1 inline-flex items-center justify-center text-center px-6 py-3 rounded-full bg-brand-navy text-white text-sm font-bold hover:bg-brand-blue transition-all shadow-comic hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 active:scale-95" href="{{ iqroLand.cta.href }}">{{ iqroLand.cta.label }}</a>
</div>
{% endif %}
</div>
</div>
<!-- END: Public Case Study Modal (Iqro Land) -->
