{% import "partials/icons.njk" as icons %}
<!-- BEGIN: KeyMetricsSection -->
<section class="py-12 bg-brand-light border-y border-brand-border" data-purpose="metrics-summary">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
{% for metric in metrics %}
<div class="bg-white p-6 rounded-2xl border border-brand-border hover:border-brand-navy transition-all duration-200 hover:shadow-comic group">
<div class="flex items-center justify-between mb-4">
<span class="text-3xl sm:text-4xl font-extrabold text-brand-navy group-hover:text-brand-blue transition-colors">{{ metric.value }}</span>
<div class="w-11 h-11 rounded-full bg-brand-ice flex items-center justify-center text-brand-blue">
{{ icons.icon(metric.icon) }}
</div>
</div>
<p class="text-sm font-semibold text-brand-slate">{{ metric.description }}</p>
</div>
{% endfor %}
</div>
</div>
</section>
<!-- END: KeyMetricsSection -->
