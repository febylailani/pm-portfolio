<!-- BEGIN: HeroSection -->
<section class="pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden" data-purpose="hero-section" id="hero">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
<!-- Left Column: Copy & CTAs -->
<div class="lg:col-span-7 space-y-6">
<!-- Category Badge -->
<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-ice text-brand-blue text-xs font-bold border border-blue-200/60" data-purpose="hero-pill">
<svg class="w-3.5 h-3.5" fill="currentColor" viewbox="0 0 24 24">
<path d="M12 2L14.4 8.2L21 9.2L16 13.8L17.5 20.3L12 16.9L6.5 20.3L8 13.8L3 9.2L9.6 8.2L12 2Z"></path>
</svg>
<span>{{ hero.pillBadge }}</span>
</div>
<!-- Headline -->
<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-navy leading-[1.15] tracking-tight">
              {{ hero.headlinePrefix }} <span class="text-brand-blue underline decoration-wavy decoration-2 decoration-brand-blue/30 underline-offset-8">{{ hero.headlineHighlight }}</span>{{ hero.headlineSuffix }}
            </h1>
<!-- Bio Description -->
<p class="text-brand-slate text-base sm:text-lg leading-relaxed max-w-2xl font-normal">
              {{ hero.bio }}
            </p>
<!-- Action Buttons -->
<div class="flex flex-wrap gap-4 pt-2">
<a class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-brand-navy text-white text-base font-semibold hover:bg-brand-blue transition-all duration-200 shadow-comic hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 active:scale-95" href="{{ hero.primaryCta.href }}">
                {{ hero.primaryCta.label }}
              </a>
<a class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-white text-brand-navy border-2 border-brand-navy text-base font-semibold hover:bg-brand-ice transition-all duration-200 active:scale-95" href="{{ hero.secondaryCta.href }}">
                {{ hero.secondaryCta.label }}
              </a>
</div>
<!-- Conversational AI Assistant Bar (Interactive Simulation) -->
<div class="pt-6" data-purpose="conversational-prompt-bar">
<div class="bg-white border-2 border-brand-navy rounded-2xl p-4 shadow-comic max-w-2xl transition-all">
<div class="flex items-center gap-3">
<div class="text-brand-blue p-2 bg-brand-ice rounded-xl flex-shrink-0">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<input class="w-full text-sm text-brand-navy placeholder:text-slate-400 border-none px-1 py-1 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue" id="ai-prompt-input" placeholder="{{ aiDemo.inputPlaceholder }}" type="text">
<button aria-label="Submit Question" class="w-9 h-9 rounded-full bg-brand-blue text-white flex items-center justify-center hover:bg-brand-cobalt transition-colors flex-shrink-0" id="ai-prompt-submit" type="button">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
<path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path>
</svg>
</button>
</div>
<!-- Quick Tags / Pills -->
<div class="mt-3.5 pt-3 border-t border-slate-100 flex items-center flex-wrap gap-2 text-xs">
<span class="text-[11px] font-bold tracking-wider text-brand-slate uppercase mr-1">{{ aiDemo.popularTopicsLabel }}</span>
{% for topic in aiDemo.topics %}<button class="ai-topic-btn inline-flex items-center min-h-[44px] sm:min-h-0 px-2.5 py-1 rounded-md bg-brand-ice hover:bg-blue-100 text-brand-blue font-medium transition-colors" data-topic="{{ topic.label }}" type="button">{{ topic.label }}</button>{% endfor %}
</div>
<!-- Dynamic feedback placeholder -->
<div aria-live="polite" class="hidden mt-3 p-3 bg-brand-ice/70 rounded-xl text-xs text-brand-navy border border-blue-200" id="ai-response-box">
<span class="font-bold text-brand-blue">{{ aiDemo.introLine }}</span>
<span id="ai-response-text">{{ aiDemo.topics[0].response }}</span>
<p class="mt-1.5 text-[10px] text-brand-slate italic">{{ aiDemo.disclosureCaption }}</p>
</div>
</div>
</div>
</div>
<!-- Right Column: Illustrated Comic Caricature Art -->
<div class="lg:col-span-5 flex justify-center relative select-none" data-purpose="hero-illustration"><div class="relative w-full max-w-md mx-auto flex flex-col items-center"><div class="absolute -top-3 right-2 bg-white border-2 border-brand-navy rounded-xl px-3 py-1 shadow-comic rotate-3 z-10"><span class="hand-annotation text-lg font-bold text-brand-navy leading-none">{{ hero.annotationCaption }}</span></div><div class="w-full bg-brand-light rounded-3xl border-2 border-brand-navy p-3 sm:p-4 shadow-comic overflow-hidden"><img alt="{{ hero.illustration.alt }}" class="w-full h-auto object-contain rounded-2xl" src="{{ hero.illustration.src | url }}"></div><div class="mt-2 flex items-center justify-between w-full px-2 text-xs font-bold text-brand-blue">{% for tag in hero.tags %}<span class="{% if tag.handwritten %}hand-annotation text-base text-brand-navy{% else %}flex items-center gap-1{% endif %}">{{ tag.label }}</span>{% endfor %}</div></div></div>
</div>
</div>
</section>
<!-- END: HeroSection -->
