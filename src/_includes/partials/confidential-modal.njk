<!-- BEGIN: Confidential Case Study Modal -->
<div aria-labelledby="modalCaseTitle" aria-modal="true" class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-300 ease-out" id="confidentialModal" inert role="dialog">
<!-- Backdrop with blur -->
<div class="fixed inset-0 bg-slate-900/60 backdrop-blur-md transition-opacity" id="confidentialModalBackdrop"></div>
<!-- Modal Dialog Card -->
<div class="relative bg-white rounded-3xl border-2 border-brand-navy max-w-xl w-full p-6 sm:p-8 shadow-2xl z-10 transform scale-95 transition-all max-h-[90vh] overflow-y-auto">
<!-- Close Button -->
<button aria-label="Close dossier" class="confidential-modal-close absolute top-4 right-4 w-11 h-11 rounded-full bg-slate-100 hover:bg-slate-200 text-brand-navy flex items-center justify-center transition-colors" type="button">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
<!-- Vault / Folder Icon Header -->
<div class="flex items-center gap-3 mb-4 pr-10">
<div class="w-12 h-12 rounded-2xl bg-brand-ice border-2 border-brand-navy flex items-center justify-center text-brand-blue shadow-comic flex-shrink-0">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
</svg>
</div>
<div class="min-w-0">
<div class="flex items-center gap-1.5 flex-wrap">
{% for badge in confidentialModal.badges %}<span class="px-2.5 py-0.5 rounded-full {% if loop.first %}bg-amber-100 text-amber-800{% else %}bg-blue-100 text-blue-700{% endif %} text-[11px] font-bold whitespace-nowrap">{{ badge }}</span>{% endfor %}
</div>
<h3 class="text-xl font-extrabold text-brand-navy mt-1" id="modalCaseTitle">{{ confidentialModal.defaultTitle }}</h3>
</div>
</div>
<!-- Explanatory Content -->
<div class="space-y-3.5 text-sm text-brand-slate leading-relaxed border-t border-b border-slate-100 py-4 my-4">
<p class="text-brand-navy font-semibold">
          {{ confidentialModal.intro }}
        </p>
</div>
<!-- Action Buttons -->
<div class="flex flex-col sm:flex-row gap-3 pt-2">
<a class="confidential-modal-schedule flex-1 inline-flex items-center justify-center text-center px-6 py-3 rounded-full bg-brand-navy text-white text-sm font-bold hover:bg-brand-blue transition-all shadow-comic hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 active:scale-95" data-body-template="{{ confidentialModal.requestBody }}" data-contact-email="{{ site.social.email }}" data-subject-template="{{ confidentialModal.requestSubject }}" href="mailto:{{ site.social.email }}?subject={{ confidentialModal.requestSubject | replace('{title}', confidentialModal.defaultTitle) | urlencode }}&amp;body={{ confidentialModal.requestBody | replace('{title}', confidentialModal.defaultTitle) | urlencode }}">
          {{ confidentialModal.primaryCta }}
        </a>
</div>
</div>
</div>
<!-- END: Confidential Case Study Modal -->
