<!DOCTYPE html>

<html class="scroll-smooth" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>{{ site.pageTitle }}</title>
<meta content="{{ site.metaDescription }}" name="description">
<link href="{{ site.siteUrl }}" rel="canonical">
<meta content="website" property="og:type">
<meta content="{{ site.siteUrl }}" property="og:url">
<meta content="{{ site.pageTitle }}" property="og:title">
<meta content="{{ site.metaDescription }}" property="og:description">
<meta content="{{ site.ogImage }}" property="og:image">
<meta content="summary_large_image" name="twitter:card">
<meta content="{{ site.pageTitle }}" name="twitter:title">
<meta content="{{ site.metaDescription }}" name="twitter:description">
<meta content="{{ site.ogImage }}" name="twitter:image">
<link href="{{ '/assets/favicons/favicon-32x32.png' | url }}" rel="icon" sizes="32x32" type="image/png">
<link href="{{ '/assets/favicons/favicon-16x16.png' | url }}" rel="icon" sizes="16x16" type="image/png">
<link href="{{ '/assets/favicons/apple-touch-icon.png' | url }}" rel="apple-touch-icon">
<!-- Tailwind CSS v3 with Plugins -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Google Fonts: Plus Jakarta Sans & Caveat for handwritten doodle notes -->
<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
<!-- Tailwind Custom Configuration -->
<script data-purpose="tailwind-config">
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              navy: '#0B1D3A',
              dark: '#081426',
              blue: '#2563EB',
              cobalt: '#1D4ED8',
              ice: '#EFF6FF',
              light: '#F8FAFC',
              slate: '#64748B',
              border: '#E2E8F0'
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            handwritten: ['"Caveat"', 'cursive']
          },
          boxShadow: {
            'comic': '3px 3px 0px 0px rgba(11, 29, 58, 0.9)',
            'comic-lg': '6px 6px 0px 0px rgba(11, 29, 58, 0.9)',
            'soft': '0 10px 25px -5px rgba(37, 99, 235, 0.05)'
          }
        }
      }
    }
  </script>
<style data-purpose="custom-typography">
    .hand-annotation {
      font-family: 'Caveat', cursive;
      letter-spacing: 0.5px;
    }
  </style>
<style data-purpose="doodle-animations">
    @keyframes subtle-float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-4px) rotate(1deg); }
    }
    .animate-float {
      animation: subtle-float 4s ease-in-out infinite;
    }
    .comic-border {
      border: 1.5px solid #0B1D3A;
    }
  </style>
<style data-purpose="public-cta-invite">
    /* ONLY the public Iqro Land card animates. The four NDA cards deliberately stay
       still , an animated "Unlock Case Study" would be beckoning a recruiter toward a
       gate they cannot open, which is worse than no animation at all. */
    .public-story-cta {
      position: relative;
      overflow: hidden;
      animation: public-cta-glow 3.6s ease-in-out infinite;
    }
    @keyframes public-cta-glow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
      50%      { box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.12); }
    }
    /* The sheen sweeps once, then rests for most of the cycle. Continuous motion in a
       reader's periphery reads as a broken page; a periodic pass reads as a nudge. */
    .public-story-cta::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: -60%;
      width: 40%;
      background: linear-gradient(100deg, transparent, rgba(5, 150, 105, 0.18), transparent);
      transform: skewX(-18deg);
      animation: public-cta-sheen 4s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes public-cta-sheen {
      0%, 55%   { left: -60%; }
      85%, 100% { left: 120%; }
    }
    /* Once the pointer is on it the invitation has done its job; further motion would
       just fight the hover state. */
    .public-story-cta:hover,
    .public-story-cta:focus-visible { animation: none; }
    .public-story-cta:hover::after,
    .public-story-cta:focus-visible::after { animation: none; opacity: 0; }

    @media (prefers-reduced-motion: reduce) {
      /* .animate-float is pre-existing and was never gated; covering it here rather than
         leaving one honoured animation next to one that ignores the setting. */
      .public-story-cta,
      .animate-float { animation: none !important; }
      .public-story-cta::after { display: none; }
    }
  </style>
</head>
<body class="bg-white text-brand-navy font-sans antialiased selection:bg-brand-ice selection:text-brand-blue min-h-screen">
<a class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-full focus:bg-brand-navy focus:text-white focus:text-sm focus:font-semibold" href="#main-content">Skip to main content</a>
<!-- Tailwind Play CDN only compiles classes it can see at parse time; these two
     (opacity-100, pointer-events-auto) are only ever added later via main.js's
     modal toggle, so they're pre-warmed here to avoid a first-toggle style lag. -->
<div class="hidden opacity-100 pointer-events-auto" aria-hidden="true"></div>
{{ content | safe }}
<script>
  window.__mockResponses = {{ aiDemo.topics | dump | safe }};
  window.__aiDemoConfig = {
    fallbackResponse: {{ aiDemo.fallbackResponse | dump | safe }},
    freeTextResponseTemplate: {{ aiDemo.freeTextResponseTemplate | dump | safe }}
  };
</script>
<script src="{{ '/assets/js/main.js' | url }}"></script>
</body></html>
